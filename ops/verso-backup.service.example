# Hourly backup, with the restore rehearsal that makes it mean something.
#
#   cp ops/verso-backup.* /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now verso-backup.timer
#
# PENDING A POSTGRES PORT — do not enable this yet. scripts/backup.mjs and
# scripts/restore.mjs still speak SQLite (VACUUM INTO, PRAGMA integrity_check)
# and predate the move to Postgres; they have not been ported to a pg_dump of
# the PGlite store (VERSO_PGLITE_PATH below) or a local Postgres server. Until
# they are, copy data/ offsite by hand. On serverless, backups are Neon's job.
# Tracked in docs/ROADMAP.md.
#
# WorkingDirectory is load-bearing: schema.sql is read relative to it. If you run
# Verso from somewhere else, set VERSO_SCHEMA_PATH instead of guessing.

[Unit]
Description=Verso backup
After=network-online.target

[Service]
Type=oneshot
User=verso
WorkingDirectory=/srv/verso
Environment=NODE_ENV=production
Environment=VERSO_PGLITE_PATH=/var/lib/verso/pgdata
Environment=VERSO_MEDIA_DIR=/var/lib/verso/media
Environment=VERSO_BACKUP_DIR=/var/lib/verso/backups
Environment=VERSO_BACKUP_HOOK=/srv/verso/ops/offsite.sh
Environment=VERSO_BACKUP_KEEP=24
ExecStart=/usr/bin/node scripts/backup.mjs

# The drill. A backup nobody has restored is a rumour, and the cheapest moment to
# discover a broken one is now rather than during the incident. Restores into a
# throwaway directory and fails the unit if the row counts disagree.
ExecStartPost=/usr/bin/node scripts/restore.mjs --latest --into /tmp/verso-restore-drill
ExecStopPost=/bin/rm -rf /tmp/verso-restore-drill

# It only ever reads the database and writes the backup directory.
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/verso /tmp

[Install]
WantedBy=multi-user.target
