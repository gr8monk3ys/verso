# Every knob Verso reads, in one file. Copy to /etc/verso.env, fill in the
# four that block launch, and `npm run preflight` will tell you if it agrees.
# The preflight is the authority — this file just enumerates what it checks.

# ---- the four launch blockers -------------------------------------------

# Absolute public origin. Reset links, the sitemap and share cards are built
# from this; unset, they point at localhost.
VERSO_BASE_URL=https://verso.example

# Where outbound mail goes. `log` writes reset links to the server log, which
# locks out anyone who forgets their password until an operator goes reading.
# The seam POSTs {to, from, subject, text} with a Bearer token — which is
# Resend's /emails contract exactly, so these four lines are all it needs:
#   1. sign up at resend.com, verify your sending domain (two DNS records)
#   2. VERSO_MAIL_FROM must be an address at that verified domain
#   3. prove it: `node scripts/preflight.mjs --send-test you@example.com`
VERSO_MAIL=webhook
VERSO_MAIL_WEBHOOK=https://api.resend.com/emails
VERSO_MAIL_TOKEN=re_your_resend_api_key
VERSO_MAIL_FROM=Verso <verso@yourdomain.example>

# The offsite copy. The catalogue rebuilds from The Met in fifteen seconds;
# the sightings rebuild from nothing. The hook is run with the backup
# directory as its argument — see ops/offsite.sh.example.
VERSO_BACKUP_HOOK=/srv/verso/ops/offsite.sh

# The database is Postgres. Two mutually exclusive shapes:
#
#   One box (systemd / container): a local PGlite store — a directory, not a
#   file. Production data lives outside the checkout so a redeploy cannot touch
#   it. (A local Postgres server works too: set DATABASE_URL=postgres://localhost
#   /verso instead of VERSO_PGLITE_PATH.)
VERSO_PGLITE_PATH=/var/lib/verso/pgdata
VERSO_MEDIA_DIR=/var/lib/verso/media
VERSO_BACKUP_DIR=/var/lib/verso/backups
#
#   Serverless (Vercel): a managed Postgres database (Neon). Set DATABASE_URL
#   INSTEAD of the three above; the local filesystem there is ephemeral and
#   preflight will refuse a local store on a serverless host. The connection
#   string carries its own credentials — there is no separate auth token. Photos
#   then go to Vercel Blob, which sets BLOB_READ_WRITE_TOKEN automatically when a
#   store is attached.
#DATABASE_URL=postgres://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# ---- strongly recommended ------------------------------------------------

# The handle promoted to staff at boot — the only way into /internal on a
# fresh database. Remove it once a second staff account exists.
VERSO_STAFF_BOOTSTRAP=your-handle

# Server errors: `log` relies on something collecting stderr; `webhook` posts
# each error (path redacted, headers never forwarded) to the URL below.
VERSO_ERROR_REPORTING=webhook
VERSO_ERROR_WEBHOOK=https://hooks.slack.com/services/replace-me

# ---- defaults that rarely need touching ----------------------------------

# Recognition on the capture screen: gallery-prior needs no service and no
# network; `http` points at your own model behind VERSO_RECOGNITION_URL.
#VERSO_RECOGNITION=gallery-prior

# Snapshots kept before rotation (the backup timer sets its own).
#VERSO_BACKUP_KEEP=24

# Only if running from a directory that is not the checkout root.
#VERSO_SCHEMA_PATH=/srv/verso/src/lib/db/schema.sql
