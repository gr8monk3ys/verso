{
  "name": "verso",
  "version": "0.1.0",
  "private": true,
  "description": "A logging, rating and review platform for art",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-sqlite scripts/db.mjs migrate",
    "db:reset": "node --experimental-sqlite scripts/db.mjs reset",
    "db:seed": "node --experimental-sqlite scripts/db.mjs seed",
    "db:demo": "node --experimental-sqlite scripts/db.mjs demo",
    "ingest:met": "node --experimental-sqlite scripts/ingest/met.mjs",
    "ingest:aic": "node --experimental-sqlite scripts/ingest/aic.mjs",
    "reconcile": "node --experimental-sqlite scripts/ingest/reconcile.mjs",
    "metrics": "node --experimental-sqlite scripts/metrics.mjs",
    "preflight": "node --experimental-sqlite scripts/preflight.mjs",
    "backup": "node --experimental-sqlite scripts/backup.mjs",
    "backup:verify": "node --experimental-sqlite scripts/restore.mjs --latest --verify",
    "backup:drill": "node --experimental-sqlite scripts/restore.mjs --latest --into .drill && rm -rf .drill",
    "restore": "node --experimental-sqlite scripts/restore.mjs",
    "eval:catalogue": "node --experimental-sqlite scripts/eval-reconciliation.mjs --arm accession --limit 120",
    "eval:catalogue:replay": "node --experimental-sqlite scripts/eval-reconciliation.mjs --arm accession --limit 120 --replay data/eval/reconciliation.json",
    "eval:catalogue:label": "node --experimental-sqlite scripts/eval-reconciliation.mjs --arm label --limit 40",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run typecheck && npm test && npm run build",
    "verify": "npm run check && npm run db:reset && npm run db:seed && npm run db:demo && npm run metrics"
  },
  "dependencies": {
    "next": "^15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
